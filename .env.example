# Voice transcription / ASR environment options
# Keep .env local; it is excluded from Git. Use .env.example as a shareable template.
# The app preserves existing process environment values over .env.
# Restart the FastAPI server after changes; correction model/effort/token cap are frozen per conversation.
# The download notebook reloads .env with override=True.

# Notebook downloads
# Optional Hugging Face token for the asset-download notebook; unused by local app inference.
HF_TOKEN=""

# OpenAI credentials
# Required for OpenAI transcription, fast translation and Astra correction. Keep the real key local.
OPENAI_API_KEY=""

# Fast English translation
# Default: gpt-6-luna. Selects the fast translator for Breeze + OpenAI and evaluation.
# The gpt-live-transcribe + gpt-6-luna pair always uses gpt-6-luna.
OPENAI_DEFAULT_MODEL="gpt-6-luna"
# Explicit fast-translation reasoning. Luna supports none, low, medium, high, xhigh, max.
# Missing/empty: none for gpt-6-luna; provider default for other models.
# Choose an effort supported by OPENAI_DEFAULT_MODEL. Independent of Astra correction.
OPENAI_DEFAULT_REASONING_EFFORT="none"
# Omit clearly unrelated background speech/noise from fast English output.
# Keep uncertain speech, technical fragments, replies, and genuine topic changes.
OPENAI_FILTER_BACKGROUND_SPEECH="true"

# Astra correction column: independent corrections and sequential conversation review
# Default: gpt-6-astra. Choose a model supporting Responses structured output and reasoning.
OPENAI_CORRECTION_MODEL="gpt-6-astra"
# Default: medium. Astra supports low, medium, high, xhigh, max.
# Other compatible models may also support none or minimal. Model support varies.
OPENAI_CORRECTION_REASONING_EFFORT="medium"
# Combined reasoning and translation-response token cap, including structured output.
# Default: 16384. Allowed: 512..16384. Smaller explicit caps are honored exactly.
# High reasoning may exhaust a smaller cap before returning a complete review.
OPENAI_CORRECTION_MAX_OUTPUT_TOKENS="16384"

# Optional local terminology
# Optional glossary path: CSV, TSV, JSON, or XLSX. Leave empty when unused.
GLOSSARY_FILE=""
# Optional do-not-translate path: TXT, CSV, TSV, JSON, or XLSX. Leave empty when unused.
# Paths may be absolute or relative to the repository when launched there; ~ is supported.
DNT_FILE=""

# Session settings configured in the React frontend, not through .env:
# Microphone and Upload WAV have independent model dropdowns, frozen on start.
# Default: gpt-live-transcribe + gpt-6-luna; alternative: Breeze + OpenAI.
# Also available: gpt-realtime-translate, with output language fixed to English.
# Realtime translation bypasses text translators, correction, terminology and speaker settings.
# Astra corrections: enabled; view: Live subtitles; Nemotron speaker detection: enabled.
# Each completed fast translation receives an independent Astra review; reviews run in parallel.
# Full comparison and Fully reviewed English also review the corrected rows sequentially.
# Both Astra passes use the model, reasoning effort, and token cap above.
# Microphone Translation type selects Fast, Corrected, Fully reviewed, or Compare all translations.
# Minimum confidence: 0.6.
# The reasoning + output token cap starts from .env and can be adjusted in the React frontend.
# Astra reviews have no automatic timeout or expiry; pending segments remain queued.
# Accepted corrections update the displayed text when review completes.
