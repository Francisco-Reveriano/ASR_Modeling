# vLLM-Hosting: Linux Streamlit client for existing hosted model instances.
# Copy to .env; process environment variables take precedence.
# Restart Streamlit after edits. Never commit credentials.

# Original-language ASR. Use the server root or a base URL ending in /v1.
VLLM_ASR_BASE_URL=
VLLM_ASR_MODEL=
VLLM_ASR_API_KEY=
# Optional language code; blank uses the served model's language selection.
VLLM_ASR_LANGUAGE=

# Comma-separated profile IDs. Each ID has a VLLM_FAST_<ID>_... group below.
# Add another group with its own URL/model/key for each hosted translator.
VLLM_FAST_PROFILES=FAST
VLLM_DEFAULT_FAST_PROFILE=FAST
VLLM_FAST_FAST_LABEL=Fast English
VLLM_FAST_FAST_BASE_URL=
VLLM_FAST_FAST_MODEL=
VLLM_FAST_FAST_API_KEY=
VLLM_FAST_FAST_MAX_TOKENS=512
# Blank optional generation fields use the server/model defaults.
VLLM_FAST_FAST_TEMPERATURE=
VLLM_FAST_FAST_REASONING_EFFORT=
# Model-specific JSON object, e.g. {"enable_thinking": false} if supported.
VLLM_FAST_FAST_CHAT_TEMPLATE_KWARGS=

# Conservatively filter clearly unrelated background speech in fast translation.
VLLM_FILTER_BACKGROUND_SPEECH=true

# Optional local terminology files. Relative paths resolve from the repository.
GLOSSARY_FILE=
DNT_FILE=

# Optional historical notebook only; unused by the app.
HF_TOKEN=

# Optional STUN/TURN servers for browser microphone access to remote Linux.
# JSON array of {"urls": "turn:host:3478", "username": "...", "credential": "..."}.
WEBRTC_ICE_SERVERS_JSON=[]
